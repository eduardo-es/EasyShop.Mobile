<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EasyShop.Mobile.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EasyShop.Mobile.Models"
    xmlns:vm="clr-namespace:EasyShop.Mobile.ViewModels"
    x:DataType="vm:ProductsViewModel"
    Title="Catálogo de Produtos"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ContentPage.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>

    <CollectionView
        ItemsSource="{Binding Products}"
        ItemSizingStrategy="MeasureAllItems"
        SelectionMode="None">

        <CollectionView.Header>
            <VerticalStackLayout Padding="16,16,16,10" Spacing="12">
                <Label
                    Text="Novo produto"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Label
                    Text="Cadastre itens com qualquer atributo (cor, tamanho, voltagem...). Nenhuma alteração de esquema é necessária."
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Nome"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Text="{Binding NewProductName, Mode=TwoWay}"
                                Placeholder="Ex.: Fone de ouvido Bluetooth"
                                MaxLength="120"
                                ReturnType="Next"
                                Style="{StaticResource FieldEntry}"
                                SemanticProperties.Description="Nome do novo produto" />
                        </Border>

                        <Label
                            Text="Preço"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Text="{Binding NewProductPrice, Mode=TwoWay}"
                                Placeholder="Ex.: 199,90"
                                MaxLength="18"
                                Keyboard="Numeric"
                                ReturnType="Done"
                                Style="{StaticResource FieldEntry}"
                                SemanticProperties.Description="Preço do novo produto" />
                        </Border>

                        <BoxView
                            HeightRequest="1"
                            Margin="0,4"
                            Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                        <Label
                            Text="Atributos dinâmicos (opcional)"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label
                            Text="Ex.: Cor = Azul, Voltagem = 220V, Tamanho = GG"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                        <VerticalStackLayout
                            Spacing="8"
                            BindableLayout.ItemsSource="{Binding Attributes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductAttributeInput">
                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                        <Border Style="{StaticResource FieldBorder}">
                                            <Entry
                                                Text="{Binding Key, Mode=TwoWay}"
                                                Placeholder="Chave"
                                                MaxLength="50"
                                                Style="{StaticResource FieldEntry}"
                                                SemanticProperties.Description="Chave do atributo dinâmico" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                            <Entry
                                                Text="{Binding Value, Mode=TwoWay}"
                                                Placeholder="Valor"
                                                MaxLength="250"
                                                Style="{StaticResource FieldEntry}"
                                                SemanticProperties.Description="Valor do atributo dinâmico" />
                                        </Border>
                                        <Button
                                            Grid.Column="2"
                                            Text="Remover"
                                            FontSize="11"
                                            Padding="8,0"
                                            HeightRequest="40"
                                            BackgroundColor="Transparent"
                                            TextColor="#D32F2F"
                                            BorderWidth="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=RemoveAttributeCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Remover este atributo" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button
                            Text="+ Adicionar atributo"
                            Command="{Binding AddAttributeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="13" />

                        <Button
                            Text="Salvar Produto"
                            Command="{Binding SaveProductCommand}"
                            CornerRadius="10"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            FontSize="15" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HeightRequest="24"
                            Color="{StaticResource Primary}" />

                        <Label
                            Text="{Binding StatusMessage}"
                            IsVisible="{Binding HasStatusMessage}"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                            <Label.Triggers>
                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding HasError}"
                                    Value="True">
                                    <Setter Property="TextColor" Value="#D32F2F" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="Produtos cadastrados"
                    Margin="0,8,0,2"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Product">
                <Border Style="{StaticResource CardBorder}" Margin="16,0,16,12">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="8">

                        <Label
                            Text="{Binding Name}"
                            FontSize="17"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Price, StringFormat='{0:C2}'}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            TextColor="{StaticResource Primary}" />

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Spacing="3"
                            BindableLayout.ItemsSource="{Binding AttributeItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductAttributeItem">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label
                                            Text="{Binding Key}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                        <Label
                                            Text=":"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                        <Label
                                            Text="{Binding Value}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="24,32" Spacing="6">
                <Label
                    Text="Nenhum produto cadastrado"
                    FontSize="15"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label
                    Text="Utilize o formulário acima para adicionar o primeiro item ao catálogo."
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
